# Porta do servidor HTTP (API REST + arquivos estáticos)
HTTP_PORT=3000

# Diretório onde estão as ROMs/ISOs do PS1
# Absoluto ou relativo à raiz do projeto
GAMES_DIR=./games

# Diretório onde estão os ISOs de PS2 (emulador experimental Play! .js)
PS2_DIR=./ps2games

# Diretório do PPSSPP Web (PSP em WebAssembly). É um build de terceiros
# espelhado por scripts/fetch-ppsspp-web.mjs (fica fora do Git). Servido em
# /ppsspp. Se a pasta não existir, o botão "PPSSPP Web (WASM)" some da tela do PSP.
PPSSPP_DIR=./ppsspp-web

# Raiz das pastas dos demais consoles da central (roms/snes, roms/nes, ...)
# Cada console tem a sua pasta e pode ser trocada pela interface (/play.html).
SYSTEMS_ROOT=./roms

# Caminho do RetroArch (modo "rodar no PC servidor").
# Se vazio, o backend procura automaticamente em locais comuns.
RETROARCH_PATH=

# Diretório das BIOS de PS1
BIOS_DIR=./bios

# Origens permitidas para CORS (* = todas)
CORS_ORIGIN=*

# URL pública (ex.: um túnel HTTPS que VOCÊ subiu por fora) usada nos links de
# convite do netplay. Ex.: PUBLIC_URL=https://abc.trycloudflare.com
PUBLIC_URL=

# Token opcional para proteger a API e o sinalizador (recomendado ao expor por túnel)
ACCESS_TOKEN=

# Nível de log: info | debug
LOG_LEVEL=info
